#!/usr/bin/env python3
"""Unofficial Faygo VPN for Linux (TUN by default; --proxy for local proxy only)."""
import argparse
import getpass
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True  # sudo must not leave root-owned caches in a user release.

# A source checkout and an installed release use the same entry point.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from faygo_client.account import Account
from faygo_client.deployment import engine_path
from faygo_client import session


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("login", help="сохранить UUID-ключ (скрытый ввод)")
    commands.add_parser("profile", help="проверить подписку")
    commands.add_parser("servers", help="показать ID серверов")
    commands.add_parser("recover", help="восстановить сеть после аварийной остановки VPN")
    start = commands.add_parser("run", help="полный VPN до Ctrl+C (root); --proxy для локального прокси")
    start.add_argument("--proxy", action="store_true", help="только локальный прокси, без root и маршрутизации")
    start.add_argument("--server", type=int, default=2, help="ID из faygo servers (по умолчанию 2: Sweden)")
    start.add_argument("--port", type=int, default=2080)
    start.add_argument("--check", action="store_true", help="проверить HTTPS и остановиться")
    args = parser.parse_args()
    if args.command == "run" and (not 1 <= args.port <= 65535 or args.server < 1):
        parser.error("Некорректный порт или ID сервера")
    if args.command == "recover" or (args.command == "run" and not args.proxy):
        if os.geteuid() != 0:
            executable = str(Path(__file__).resolve())
            os.execvp("sudo", ["sudo", sys.executable, executable, *sys.argv[1:]])
    if args.command == "recover":
        session.recover()
        return
    account = Account()
    if args.command == "login":
        account.login(getpass.getpass("UUID-ключ Faygo: "))
        print("Ключ сохранён в ~/.config/faygo-cli/key (0600). Проверка: faygo profile")
    elif args.command == "profile":
        profile = account.profile()
        for field in ("name", "expiration_at", "data_usage", "data_limit"):
            print(f"{field}: {profile.get(field, '—')}")
    elif args.command == "servers":
        for server in account.servers():
            print(f"{server['id']:>3}  {server['name']}")
    else:
        binary = engine_path(account.home)
        config = account.connection(args.server, args.port)
        session.run(config, binary, args.port, proxy=args.proxy, check=args.check)


if __name__ == "__main__":
    os.umask(0o077)
    try:
        main()
    except KeyboardInterrupt:
        print("\nFaygo остановлен.", file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, OSError, ValueError, EOFError) as error:
        print(f"Ошибка: {error}", file=sys.stderr)
        sys.exit(1)
